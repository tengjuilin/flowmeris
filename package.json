{
  "name": "flowmeris-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based, client-side flow cytometry analysis with rigorous, documented methods.",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @flowmeris/web dev",
    "build": "corepack pnpm --filter @flowmeris/web build",
    "preview": "vitepress preview docs --port 4174 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:deps": "depcruise packages apps/web/src e2e --ignore-known",
    "lint:size": "node tools/check-size.mjs",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "vitest run --project golden",
    "e2e": "playwright test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "build:site": "corepack pnpm build && DOCS_BASE=${DOCS_BASE:-/} vitepress build docs && rm -rf docs/.vitepress/dist/app && cp -R apps/web/dist docs/.vitepress/dist/app",
    "fixtures:fetch": "node tools/fetch-fixtures.mjs",
    "fonts:fetch": "node tools/fetch-fonts.mjs",
    "postinstall": "node tools/fetch-fonts.mjs --optional",
    "golden:inputs": "GOLDEN_WRITE=1 vitest run packages/export/test/golden-inputs.test.ts",
    "golden": "corepack pnpm golden:inputs && uv run --project tools/golden/python python tools/golden/python/generate.py",
    "check": "corepack pnpm lint && corepack pnpm lint:deps && corepack pnpm lint:size && corepack pnpm typecheck && corepack pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9",
    "@playwright/test": "^1.48",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/node": "^22",
    "dependency-cruiser": "^16",
    "fast-check": "^3.22",
    "jsdom": "^25",
    "markdown-it-mathjax3": "^4",
    "typescript": "~5.6",
    "vitepress": "^1.4",
    "vitest": "^2.1"
  }
}
