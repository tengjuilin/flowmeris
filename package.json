{
  "name": "flowmeris-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based, client-side flow cytometry analysis with rigorous, documented methods.",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @flowmeris/web dev",
    "build": "pnpm --filter @flowmeris/web build",
    "preview": "pnpm --filter @flowmeris/web preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "vitest run --project golden",
    "e2e": "playwright test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9",
    "@playwright/test": "^1.48",
    "@types/node": "^22",
    "fast-check": "^3.22",
    "typescript": "~5.6",
    "vitepress": "^1.4",
    "vitest": "^2.1"
  }
}
